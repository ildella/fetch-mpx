{
  "name": "fetch-mpx",
  "version": "0.2.0",
  "description": "Dependency-injected HTTP client with pluggable platform fetch, content-type detection, and error mapping.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/ildella/fetch-mpx",
  "repository": {
    "type": "git",
    "url": "git://github.com/ildella/fetch-mpx.git"
  },
  "author": {
    "name": "Daniele Dellafiore",
    "url": "https://linktr.ee/ildella/"
  },
  "keywords": [
    "fetch",
    "http-client",
    "content-type",
    "dependency-injection",
    "esm"
  ],
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "exports": {
    ".": "./src/index.js",
    "./platform-browser": "./src/platform-browser.js",
    "./platform-node": "./src/platform-node.js"
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check:lint": "eslint --report-unused-disable-directives .",
    "lint": "eslint . --cache --max-warnings 0",
    "lint.nocache": "eslint . --max-warnings 0",
    "lint.inspect": "npx @eslint/config-inspector",
    "test": "vitest",
    "coverage": "vitest run --coverage"
  },
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e",
  "devDependencies": {
    "@eslint/compat": "2.1.0",
    "@eslint/js": "10.0.1",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "9.39.5",
    "eslint-nostandard": "1.1.0",
    "globals": "17.12.0",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@stylistic/eslint-plugin": "5.10.0"
  }
}
